{
  "name": "directory-validator",
  "version": "1.5.4",
  "description": "CLI Tool to validate directory structures.",
  "main": "dist/index.js",
  "bin": {
    "directory-validator": "dist/index.js"
  },
  "scripts": {
    "dev": "npx tsx src/index.ts",
    "build": "npm run clean && tsc && cp src/resources/* dist/resources",
    "clean": "rm -rf dist",
    "format": "biome format",
    "format-fix": "biome format --write",
    "lint": "biome lint",
    "lint-fix": "biome lint --write",
    "test": "npm run format && npm run lint && vitest run"
  },
  "author": "Erwin Gaitan O <erwingaitano@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@types/glob": "^7.1.3",
    "@types/node": "^20.14.12",
    "prettier": "^2.5.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.4"
  },
  "dependencies": {
    "ajv": "^8.0.2",
    "colors": "1.4.0",
    "commander": "^7.2.0",
    "glob": "^7.1.6",
    "goerwin-helpers": "^1.0.2"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goerwin/directory-validator.git"
  },
  "keywords": [
    "directory",
    "validator",
    "validation",
    "folder"
  ],
  "bugs": {
    "url": "https://github.com/goerwin/directory-validator/issues"
  },
  "homepage": "https://github.com/goerwin/directory-validator#readme"
}
